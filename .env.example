# Deployment credentials
# Run `python generate_env.py` before Docker Compose. The generator fills every
# empty secret, preserves existing settings, and never prints secret values.
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
IPTV_AUTH_PASSWORD=
IPTV_SECRET_KEY=

# Application database account. Do not use root.
DB_HOST=mysql
DB_PORT=3306
DB_USER=iptv_app
# Used only by the one-time migrate-2-0 service when creating the MySQL user.
DB_USER_HOST=%
DB_NAME=iptv-all-in-one
DB_CHARSET=utf8mb4

# Web authentication. Generated passwords are intentionally independent from
# both database passwords.
IPTV_AUTH_USERNAME=admin
IPTV_AUTH_REALM=iptv-all-in-one

# Optional source/development overrides. Keep IPTV_OUTPUT_DIR empty outside a
# container to use the repository's output directory. Trusted origins must be
# complete HTTP(S) origins separated by commas; leave empty unless a reverse
# proxy or development proxy requires an explicit origin.
IPTV_OUTPUT_DIR=
IPTV_TRUSTED_ORIGINS=
# Emergency compatibility only: comma-separated TLS hostnames for which
# certificate verification is disabled. Leave empty whenever possible.
IPTV_INSECURE_TLS_HOSTS=

# Host Web port. The container always listens on 58080.
PORT=58080

# MySQL is exposed only on host loopback by default.
MYSQL_HOST_PORT=3306

# Lightweight MySQL defaults suitable for small servers.
MYSQL_PERFORMANCE_SCHEMA=OFF
MYSQL_INNODB_BUFFER_POOL_SIZE=64M
MYSQL_INNODB_LOG_BUFFER_SIZE=8M
MYSQL_MAX_CONNECTIONS=50
MYSQL_TABLE_OPEN_CACHE=200
MYSQL_TABLE_DEFINITION_CACHE=400

# For an external MySQL deployment, set DB_HOST/DB_PORT/DB_USER/DB_PASSWORD and
# start with docker-compose.external-mysql.yml. The account must already exist
# and have access only to the configured application database.
